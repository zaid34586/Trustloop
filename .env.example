# Supabase project settings (found in your Supabase dashboard: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for email confirmation and password reset links.
# Locally: http://localhost:3000  In production: your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI settings (server-side only, never exposed to the browser)
# AI_PROVIDER: "openrouter" (default) or "anthropic".
# OpenRouter keys (sk-or-...) always use OpenRouter regardless of this.
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL is the single variable to switch models (e.g. OpenRouter's
# "openai/gpt-4o-mini" or Anthropic's "claude-3-5-haiku-latest").
# Paid models are fast and reliable at fractions of a cent per
# questionnaire; ":free" models cost nothing but are slower and more
# often rate-limited or return unparseable output.
AI_MODEL=
# Optional: comma-separated fallback model IDs used when the primary
# model fails (429/5xx/timeout) or returns unparseable JSON.
AI_MODEL_FALLBACKS=

# Optional second AI provider (slot 2), tried automatically when slot 1
# fails or is cooling down. Leave all four unset to run a single
# provider.
# AI_P2_TYPE: "openrouter" | "anthropic" | "gemini" | "openai-compatible"
AI_P2_TYPE=
AI_P2_API_KEY=
AI_P2_MODEL=
# Only needed for AI_P2_TYPE=openai-compatible (otherwise the built-in
# default base URL for the type is used).
AI_P2_BASE_URL=

# Optional: max AI requests per provider per minute (default 8).
AI_RPM_LIMIT=
