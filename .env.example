# Supabase project settings (found in your Supabase dashboard: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for email confirmation and password reset links.
# Locally: http://localhost:3000  In production: your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI settings (server-side only, never exposed to the browser)
# AI_PROVIDER: "anthropic" (default) or "openrouter"
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
