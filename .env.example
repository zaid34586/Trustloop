# Supabase project settings (found in your Supabase dashboard: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for email confirmation and password reset links.
# Locally: http://localhost:3000  In production: your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI settings (server-side only, never exposed to the browser)
# AI_PROVIDER: "openrouter" (default) or "anthropic".
# OpenRouter keys (sk-or-...) always use OpenRouter regardless of this.
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL is the single variable to switch models (e.g. OpenRouter's
# "openai/gpt-4o-mini" or Anthropic's "claude-3-5-haiku-latest").
# Paid models are fast and reliable at fractions of a cent per
# questionnaire; ":free" models cost nothing but are slower and more
# often rate-limited or return unparseable output.
AI_MODEL=
# Optional: comma-separated fallback model IDs used when the primary
# model fails (429/5xx/timeout) or returns unparseable JSON.
AI_MODEL_FALLBACKS=

# Optional second AI provider (slot 2), tried automatically when slot 1
# fails or is cooling down. Leave all four unset to run a single
# provider.
# AI_P2_TYPE: "openrouter" | "anthropic" | "gemini" | "openai-compatible"
AI_P2_TYPE=
AI_P2_API_KEY=
AI_P2_MODEL=
# Only needed for AI_P2_TYPE=openai-compatible (otherwise the built-in
# default base URL for the type is used).
AI_P2_BASE_URL=

# Optional: max AI requests per provider per minute (default 8).
AI_RPM_LIMIT=

# ------------------------------------------------------------
# Phase 4 — Ollama / GPU slots (code is ready; fill these in during
# the connection phase). Slot order: local Ollama -> cloud GPU ->
# the API providers above.
# ------------------------------------------------------------

# Slot 10: local Ollama (your machine / an always-on box).
# Leave OLLAMA_URL blank to skip this slot.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:14b-instruct
# Only needed if your Ollama server requires auth.
OLLAMA_API_KEY=

# Slot 11: cloud GPU — an AWS EC2 instance running Ollama.
# Leave GPU_OLLAMA_URL blank to skip this slot.
GPU_OLLAMA_URL=
GPU_OLLAMA_MODEL=qwen2.5:14b-instruct
GPU_API_KEY=

# EC2 on-demand start/stop (required for auto-start on activity and
# auto-stop after AI_IDLE_MINUTES without activity). Needs an IAM
# user/role with ec2:StartInstances + ec2:StopInstances on the
# instance below.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_EC2_INSTANCE_ID=

# Minutes of no activity before the GPU instance auto-stops
# (default 10; decimals allowed for quick tests, e.g. 0.05 = 3s).
AI_IDLE_MINUTES=

# Secret for GET/POST /api/cron/ai-idle. Vercel cron sends it as
# "Authorization: Bearer $CRON_SECRET" automatically when set.
CRON_SECRET=

# Service-role key for the cron route (Supabase: Settings > API >
# service_role). Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
